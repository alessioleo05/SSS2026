pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/alessioleo05/SomeBankingApp.git'
            }
        }
        stage('Build Backend') {
            steps {
                sh 'docker build -t backend-container ./backend'
            }
        }
        stage('Build Frontend') {
            steps {
                sh 'docker build -t frontend-container ./frontend'
            }
        }
    }
}