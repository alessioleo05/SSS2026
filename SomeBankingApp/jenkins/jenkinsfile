pipeline {
    agent any

    environment {
        FE_IMAGE = "somebankingapp-fe:${BUILD_NUMBER}"
        BE_IMAGE = "somebankingapp-be:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/alessioleo05/SSS2026.git'
            }
        }

        stage('Build Frontend (FE)') {
            steps {
                sh 'docker build -f SomeBankingApp/frontend/Dockerfile -t ${FE_IMAGE} SomeBankingApp/frontend'
            }
        }

        stage('Build Backend (BE)') {
            steps {
                sh 'docker build -f SomeBankingApp/backend/Dockerfile -t ${BE_IMAGE} SomeBankingApp/backend'
            }
        }
    }

    post {
        success {
            echo "Build completate: ${FE_IMAGE} e ${BE_IMAGE}"
        }
        failure {
            echo "Errore durante la build. Controlla il Console Output."
        }
    }
}